# EJE Project Tracker — environment template.
#
# COPY THIS TO /etc/eje-tracker/tracker.env AND FILL IT IN THERE.
# The real file is owned by root, mode 0640, group eje-tracker, and is NEVER
# committed to Git. No password, token or connection string belongs in this
# repository — this file carries placeholders only.

# The tracker's own database, its own role. It has no access to the EJE
# application's database and must never be given any.
TRACKER_DATABASE_URL=postgres://eje_tracker_app:REPLACE_WITH_A_GENERATED_PASSWORD@127.0.0.1:5432/eje_tracker

# Loopback only. The tracker is reached over an SSH tunnel; it is not published.
TRACKER_HOST=127.0.0.1
TRACKER_PORT=3100

# Set this to yes ONLY while the tracker is reached over a plain-HTTP SSH
# tunnel, which is how it starts life. It makes the session cookie non-Secure so
# that a browser will send it over http://127.0.0.1. The moment the tracker is
# put behind HTTPS, REMOVE THIS LINE.
TRACKER_INSECURE_COOKIES=yes

# How long a signed-in session lasts.
TRACKER_SESSION_DAYS=30

# The EJE checkout the importer READS. Never written to.
EJE_REPO_PATH=/srv/eje/app

# Where deployment evidence comes from: the live application's own build stamp.
EJE_HEALTH_URL=https://eje.syncza.co.za/api/health
